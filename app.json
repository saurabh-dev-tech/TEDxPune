{
  "expo": {
    "name": "TEDxPune Tribe",
    "slug": "TEDxPune",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tedxpune",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tedxpune.community",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app requires access to your photo library to let you select and update your profile picture.",
        "NSPhotoLibraryAddUsageDescription": "This app requires permission to save photos to your photo library.",
        "NSCameraUsageDescription": "This app requires access to your camera to let you take a new profile picture.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInWebContent": true,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.tedxpune.community",
      "versionCode": 11,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "This app requires access to your photo library to let you select and update your profile picture.",
          "cameraPermission": "This app requires access to your camera to let you take a new profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "45f5ac71-1402-47f9-b7dd-141e6a1c5a83"
      }
    },
    "runtimeVersion": "1.0.9",
    "updates": {
      "url": "https://u.expo.dev/45f5ac71-1402-47f9-b7dd-141e6a1c5a83",
      "fallbackToCacheTimeout": 0
    }
  }
}
